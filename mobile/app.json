{
  "expo": {
    "name": "Go Wash",
    "slug": "go-wash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gowash",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brightaangel.gowash",
      "buildNumber": "4",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Go Wash needs your location to find nearby drivers and set pickup/delivery addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Go Wash needs your location to show live pickup status and delivery updates.",
        "NSCameraUsageDescription": "Go Wash needs access to the camera to allow uploading photos.",
        "NSPhotoLibraryUsageDescription": "Go Wash needs access to photo library for profile and order pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.brightaangel.gowash",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Go Wash",
      "shortName": "Go Wash",
      "themeColor": "#E6F4FE",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "bright-aangel",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9425891-19fe-4065-a556-01d1562b83dd"
      }
    }
  }
}


