{
    "expo": {
        "name": "mobile-tuk",
        "slug": "mobile-tuk",
        "owner": "bright-aangel",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "mobile-tuk",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.brightangel.gowash.tuk"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#ffffff"
            },
            "package": "com.brightangel.gowash.tuk"
        },

        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router"
        ],
        "experiments": {
            "typedRoutes": true,
            "tsconfigPaths": true
        },

        "extra": {
            "eas": {
                "projectId": "fd415f73-bc2f-40b9-a98a-40e1e6baea5d"
            }
        }
    }
}